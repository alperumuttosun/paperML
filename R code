# --- Function: fit Linear Regression on a source set, predict on target country ---
fit_and_predict_lm <- function(source_countries_str, target_country, data) {
  
  source_countries <- strsplit(source_countries_str, ";")[[1]]
  
  train_df <- data[data$Country_ISO %in% source_countries, ]
  test_df  <- data[data$Country_ISO == target_country, ]
  
  # Drop rows with missing predictors or target (simple pilot approach -
  # we can revisit imputation later once we decide on GDP handling)
  needed_cols <- c(predictor_cols, target_col)
  train_df <- train_df[complete.cases(train_df[, needed_cols]), ]
  test_df  <- test_df[complete.cases(test_df[, needed_cols]), ]
  
  if (nrow(train_df) < 10 || nrow(test_df) < 1) {
    return(data.frame(rmse = NA, mae = NA, n_train = nrow(train_df), n_test = nrow(test_df)))
  }
  
  formula_str <- paste(target_col, "~", paste(predictor_cols, collapse = " + "))
  model <- lm(as.formula(formula_str), data = train_df)
  
