# STEP 7 (RQ5 pilot) - Environmental distance vs prediction error
# PILOT: wheat only, LM model only, to validate the approach before
# scaling to all 8 crops / 5 models.
# ============================================================
# Logic:
# 1) Re-generate the exact same random source-country subsets used in
#    the full run (same seed formula), so we know which countries were
#    in each (target, N, replicate) draw.
# 2) Compute the "distance" between the target country's own predictor
#    values and the source-set's predictor distribution, using
#    Mahalanobis distance (a standard method from ecology/SDM literature
#    for measuring how far a new point falls from a reference distribution).
# 3) Merge this distance score with the already-computed RMSE for that
#    exact (target, N, replicate) combination.
# 4) Check: does higher distance correlate with higher RMSE?

if (!require("readxl")) install.packages("readxl")
library(readxl)

data_dir   <- "C:/Users/Alper.Tosun/Desktop/cru130"
output_dir <- "C:/Users/Alper.Tosun/Desktop/pamuk/mlpaper"

wheat <- read_excel(file.path(data_dir, "panelv7_wheat.xlsx"))

# Load the full results (we'll filter to wheat + LM only for this pilot)
cat("Loading full results (filtering to wheat + LM)...\n")
full_results <- read.csv(file.path(output_dir, "step4_FULL_climate_gdp_results.csv"))
wheat_lm_results <- full_results[full_results$crop == "wheat" & full_results$model == "LM", ]
cat("Wheat + LM rows:", nrow(wheat_lm_results), "\n")

predictor_cols <- c("TMP_ann", "TMX_ann", "TMN_ann", "PRE_ann", "GDP_per_Capita")

# --- Function: compute Mahalanobis distance between a target country's
# mean predictor values and the source-set's predictor distribution ---
compute_mahalanobis_distance <- function(source_countries, target_country, data) {
  
  source_df <- data[data$Country_ISO %in% source_countries, predictor_cols]
  target_df <- data[data$Country_ISO == target_country, predictor_cols]
  
  source_df <- source_df[complete.cases(source_df), ]
  target_df <- target_df[complete.cases(target_df), ]
  
  if (nrow(source_df) < length(predictor_cols) + 5 || nrow(target_df) < 1) {
    return(NA)  # not enough data to compute a stable covariance matrix
  }
  
  source_mean <- colMeans(source_df)
  source_cov  <- cov(source_df)
  
  # If the covariance matrix is singular (can happen with small source sets),
  # Mahalanobis distance can't be computed - return NA rather than erroring.
  target_mean_point <- colMeans(target_df)  # average the target country's own years
  
  dist <- tryCatch({
    mahalanobis(target_mean_point, center = source_mean, cov = source_cov)
  }, error = function(e) NA)
  
  sqrt(dist)  # mahalanobis() returns squared distance; take sqrt for the usual scale
}

# --- Regenerate the exact same (target, N, replicate) source-sets used
# in the full run, using the SAME seed formula as step4_FULL ---
all_countries <- sort(unique(wheat$Country_ISO))
source_sizes <- c(5, 10, 20, 40, 60)
n_replicates <- 50

cat("\nRegenerating source-country subsets and computing distances...\n")
cat("(This will take a few minutes - computing Mahalanobis distance for each combination)\n")

distance_results <- list()
row_i <- 1
start_time <- Sys.time()

for (target in all_countries) {
  remaining <- setdiff(all_countries, target)
  target_idx <- which(all_countries == target)
  
  for (N in source_sizes) {
    if (N > length(remaining)) next
    
    for (r in 1:n_replicates) {
      # EXACT same seed formula as step4_FULL_climate_gdp.R
      set.seed(10000 * target_idx + 100 * N + r)
      source_set <- sample(remaining, size = N, replace = FALSE)
      
      dist <- compute_mahalanobis_distance(source_set, target, wheat)
      
      distance_results[[row_i]] <- data.frame(
        target_country = target, N = N, replicate_id = r, distance = dist
      )
      row_i <- row_i + 1
    }
  }
}

elapsed <- as.numeric(difftime(Sys.time(), start_time, units = "secs"))
cat("Done computing distances in", round(elapsed, 1), "seconds.\n")

distance_df <- do.call(rbind, distance_results)

# --- Merge distance scores with the RMSE results ---
merged <- merge(wheat_lm_results, distance_df,
                by = c("target_country", "N", "replicate_id"))

cat("\nMerged rows:", nrow(merged), "\n")
cat("Rows with valid (non-NA) distance:", sum(!is.na(merged$distance)), "\n")

merged_valid <- merged[!is.na(merged$distance) & !is.na(merged$rmse) & is.finite(merged$distance), ]
cat("Rows with valid distance AND valid rmse:", nrow(merged_valid), "\n")

# --- Correlation check: does higher distance -> higher RMSE? ---
cat("\n==== CORRELATION: Mahalanobis distance vs RMSE (wheat, LM) ====\n")
cor_result <- cor.test(merged_valid$distance, merged_valid$rmse, method = "spearman")
cat("Spearman correlation:", round(cor_result$estimate, 3), "\n")
cat("p-value:", format.pval(cor_result$p.value, digits = 3), "\n")

cor_pearson <- cor.test(merged_valid$distance, merged_valid$rmse, method = "pearson")
cat("Pearson correlation:", round(cor_pearson$estimate, 3), "\n")

