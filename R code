BASELINE_START <- 1990
BASELINE_END   <- 2000
BASELINE_LEN   <- BASELINE_END - BASELINE_START + 1   # 11

compute_baseline <- function(df) {
  df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::group_modify(function(sub, key) {
      in_window <- sub[sub$Yil >= BASELINE_START & sub$Yil <= BASELINE_END, ]
      
      if (nrow(in_window) >= 1) {
        used_years <- sort(in_window$Yil)
        base_prod  <- mean(in_window$production_tonnes, na.rm = TRUE)
        base_area  <- mean(in_window$area_harvested_ha, na.rm = TRUE)
        is_fallback <- 0L
      } else {
        # Fallback: earliest available years for this country (up to 11)
        sub_sorted <- sub[order(sub$Yil), ]
        take_n     <- min(BASELINE_LEN, nrow(sub_sorted))
        fallback_rows <- sub_sorted[seq_len(take_n), ]
        used_years    <- sort(fallback_rows$Yil)
        base_prod     <- mean(fallback_rows$production_tonnes, na.rm = TRUE)
        base_area     <- mean(fallback_rows$area_harvested_ha, na.rm = TRUE)
        is_fallback   <- 1L
      }
      
      period_label <- if (length(used_years) == 0) NA_character_ else
        paste0(min(used_years), "-", max(used_years))
      
      data.frame(
        baseline_production_tonnes = base_prod,
        baseline_area_harvested_ha = base_area,
        baseline_period_used       = period_label,
        baseline_is_fallback       = is_fallback,
        stringsAsFactors = FALSE)
    }) %>%
    dplyr::ungroup()
}

