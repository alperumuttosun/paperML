# ------------------------------------------------------------
# HELPER FUNCTIONS (identical to what the full run will use)
# ------------------------------------------------------------

# Scales predictors using ONLY the training (source) countries' mean/sd,
# then applies that same scaling to the test (target) country. This avoids
# leaking any information from the unseen target country into the model.
standardize_with_train_stats <- function(train_df, test_df, cols) {
  train_means <- sapply(train_df[, cols], mean, na.rm = TRUE)
  train_sds   <- sapply(train_df[, cols], sd, na.rm = TRUE)
  for (col in cols) {
    train_df[[col]] <- (train_df[[col]] - train_means[col]) / train_sds[col]
    test_df[[col]]  <- (test_df[[col]]  - train_means[col]) / train_sds[col]
  }
  list(train = train_df, test = test_df)
}

# Splits the crop dataset into a source (train) set and target (test) set,
# and drops any rows with missing predictor or yield values.
prepare_train_test <- function(source_countries, target_country, data) {
  train_df <- data[data$Country_ISO %in% source_countries, ]
  test_df  <- data[data$Country_ISO == target_country, ]
  needed_cols <- c(predictor_cols, target_col)
  train_df <- train_df[complete.cases(train_df[, needed_cols]), ]
  test_df  <- test_df[complete.cases(test_df[, needed_cols]), ]
  list(train = train_df, test = test_df)
}

# Computes RMSE and MAE between predicted and actual yield.
compute_metrics <- function(preds, actual) {
  data.frame(rmse = sqrt(mean((preds - actual)^2)), mae = mean(abs(preds - actual)))
}

# --- The 5 model-fitting functions ---

fit_lm <- function(train_df, test_df) {
  # Ordinary least squares: fits a straight-line relationship between
  # yield and the predictors.
  formula_str <- paste(target_col, "~", paste(predictor_cols, collapse = " + "))
  model <- lm(as.formula(formula_str), data = train_df)
  predict(model, newdata = test_df)
}

fit_lasso <- function(train_df, test_df) {
  # L1-regularized regression: like LM, but shrinks less-useful predictors'
  # coefficients toward zero. cv.glmnet picks the penalty strength using
  # cross-validation INSIDE the training data only (target never touched).
  x_train <- as.matrix(train_df[, predictor_cols]); y_train <- train_df[[target_col]]
  x_test  <- as.matrix(test_df[, predictor_cols])
  cv_model <- cv.glmnet(x_train, y_train, alpha = 1)
  as.numeric(predict(cv_model, newx = x_test, s = "lambda.min"))
}

fit_gam <- function(train_df, test_df) {
  # Generalized Additive Model: allows each predictor to have a smooth,
  # nonlinear (not necessarily straight-line) relationship with yield.
  formula_str <- paste(target_col, "~ s(TMP_ann) + s(TMX_ann) + s(TMN_ann) + s(PRE_ann) + s(GDP_per_Capita)")
  model <- gam(as.formula(formula_str), data = train_df)
  as.numeric(predict(model, newdata = test_df))
}

fit_rf <- function(train_df, test_df) {
  # Random Forest: an ensemble of decision trees, each trained on a
  # bootstrap sample of the training data. Captures nonlinear interactions
  # automatically. ntree=100 is a common literature-standard setting.
  formula_str <- paste(target_col, "~", paste(predictor_cols, collapse = " + "))
  model <- randomForest(as.formula(formula_str), data = train_df, ntree = 100)
  predict(model, newdata = test_df)
}

fit_xgb <- function(train_df, test_df) {
  # Gradient boosting: builds trees sequentially, each correcting the
  # errors of the previous ones. Uses the new xgboost 3.x simplified API
