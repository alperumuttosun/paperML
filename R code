  # --- Detrend: for each country, regress yield on year, keep residuals ---
  cat("Detrending yield (country-specific linear time trend removed)...\n")
  crop_data$yield_detrended <- NA_real_

  for (iso in unique(crop_data$Country_ISO)) {
    idx <- crop_data$Country_ISO == iso
    sub <- crop_data[idx, ]
    if (sum(!is.na(sub$yield_hg_per_ha)) < 5) next  # need enough points for a stable trend

    trend_model <- lm(yield_hg_per_ha ~ Yil, data = sub)
    crop_data$yield_detrended[idx] <- residuals(trend_model)[match(rownames(sub), names(residuals(trend_model)))]
  }

  n_detrended <- sum(!is.na(crop_data$yield_detrended))
  cat("Detrended yield available for", n_detrended, "of", nrow(crop_data), "rows\n")

  all_countries <- sort(unique(crop_data$Country_ISO))

  # --- Run the SAME sampling design, twice: once on raw yield, once on detrended ---
  for (y_col in c("yield_hg_per_ha", "yield_detrended")) {

    cat("\n--- Target variable:", y_col, "---\n")
