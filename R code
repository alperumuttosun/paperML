# results from step4_FULL_climate_gdp_results.csv.
#
# RESUMABLE: after each crop finishes, results are saved to a
# checkpoint file. If interrupted (computer restart, etc.), simply
# re-run this script - it will skip crops that already have a
# checkpoint and continue with the rest.
# ============================================================

if (!require("readxl")) install.packages("readxl")
library(readxl)

data_dir   <- "C:/Users/Alper.Tosun/Desktop/cru130"
output_dir <- "C:/Users/Alper.Tosun/Desktop/pamuk/mlpaper"
checkpoint_dir <- file.path(output_dir, "checkpoints_RQ5_distance")
if (!dir.exists(checkpoint_dir)) dir.create(checkpoint_dir, recursive = TRUE)

all_crops <- c("wheat", "barley", "oats", "rye", "rice", "maize", "soybean", "sorghum")
source_sizes <- c(5, 10, 20, 40, 60)
n_replicates <- 50
predictor_cols <- c("TMP_ann", "TMX_ann", "TMN_ann", "PRE_ann", "GDP_per_Capita")

# --- Load the full RMSE results ONCE (all crops, all models) ---
cat("Loading full climate+GDP results file (~1M rows, may take a moment)...\n")
full_results <- read.csv(file.path(output_dir, "step4_FULL_climate_gdp_results.csv"))
cat("Loaded", nrow(full_results), "rows.\n")

# --- Function: Mahalanobis distance between target country and source-set ---
compute_mahalanobis_distance <- function(source_countries, target_country, data) {
  source_df <- data[data$Country_ISO %in% source_countries, predictor_cols]
  target_df <- data[data$Country_ISO == target_country, predictor_cols]
  source_df <- source_df[complete.cases(source_df), ]
  target_df <- target_df[complete.cases(target_df), ]
  
  if (nrow(source_df) < length(predictor_cols) + 5 || nrow(target_df) < 1) {
    return(NA)
  }
  
  source_mean <- colMeans(source_df)
  source_cov  <- cov(source_df)
  target_mean_point <- colMeans(target_df)
  
  dist <- tryCatch({
    mahalanobis(target_mean_point, center = source_mean, cov = source_cov)
  }, error = function(e) NA)
  
  sqrt(dist)
}

# --- CHECKPOINT LOGIC: skip crops that already have a saved checkpoint ---
already_done <- c()
for (crop_name in all_crops) {
  ckpt_file <- file.path(checkpoint_dir, paste0(crop_name, "_distance_done.csv"))
  if (file.exists(ckpt_file)) already_done <- c(already_done, crop_name)
}
if (length(already_done) > 0) {
  cat("NOTE: found existing checkpoints for:", paste(already_done, collapse=", "), "\n")
  cat("These crops will be SKIPPED. Delete their checkpoint files in\n")
  cat(checkpoint_dir, "\nif you want to re-run them.\n\n")
}
crops_to_run <- setdiff(all_crops, already_done)

# ------------------------------------------------------------
# MAIN LOOP - one crop at a time, with checkpointing and timing
# ------------------------------------------------------------

overall_start <- Sys.time()

for (crop_name in crops_to_run) {
  
  crop_start <- Sys.time()
  cat("\n\n========== CROP:", crop_name, "started at", format(crop_start), "==========\n")
  
  crop_file <- file.path(data_dir, paste0("panelv7_", crop_name, ".xlsx"))
  crop_data <- read_excel(crop_file)
  all_countries <- sort(unique(crop_data$Country_ISO))
  
  crop_results <- list()
  row_i <- 1
  
  for (target in all_countries) {
    remaining <- setdiff(all_countries, target)
    target_idx <- which(all_countries == target)
    
    for (N in source_sizes) {
      if (N > length(remaining)) next
      
      for (r in 1:n_replicates) {
        # EXACT same seed formula as step4_FULL_climate_gdp.R - this
        # reproduces the identical source-country draws.
        set.seed(10000 * target_idx + 100 * N + r)
        source_set <- sample(remaining, size = N, replace = FALSE)
        
        dist <- compute_mahalanobis_distance(source_set, target, crop_data)
        
        crop_results[[row_i]] <- data.frame(
          crop = crop_name, target_country = target, N = N,
          replicate_id = r, distance = dist
        )
        row_i <- row_i + 1
      }
    }
  }
  
  crop_dist_df <- do.call(rbind, crop_results)
  crop_elapsed_min <- as.numeric(difftime(Sys.time(), crop_start, units = "mins"))
  
  # --- Merge with RMSE results for this crop (all 5 models) ---
  crop_rmse <- full_results[full_results$crop == crop_name, ]
  crop_merged <- merge(crop_rmse, crop_dist_df,
                       by = c("crop", "target_country", "N", "replicate_id"))
  
  # --- Save checkpoint ---
  ckpt_file <- file.path(checkpoint_dir, paste0(crop_name, "_distance_done.csv"))
  write.csv(crop_merged, ckpt_file, row.names = FALSE)
  
  cat("CROP", crop_name, "DONE. Distance rows:", nrow(crop_dist_df),
      "| Merged rows:", nrow(crop_merged),
      "| Time:", round(crop_elapsed_min, 1), "min | Saved to:", ckpt_file, "\n")
  
  total_elapsed_hours <- as.numeric(difftime(Sys.time(), overall_start, units = "hours"))
  cat("Cumulative elapsed time so far:", round(total_elapsed_hours, 2), "hours\n")
  
  # --- Rough projection after first crop completes ---
  if (crop_name == crops_to_run[1]) {
    remaining_crops <- length(crops_to_run) - 1
    projected_total_hours <- total_elapsed_hours * length(crops_to_run)
    cat("\n>>> PROJECTION based on this first crop's actual time:\n")
    cat(">>> Estimated TOTAL time for all", length(crops_to_run), "remaining crops:",
        round(projected_total_hours, 1), "hours\n\n")
  }
}

# ------------------------------------------------------------
# COMBINE ALL CHECKPOINTS
# ------------------------------------------------------------
cat("\n\n==== COMBINING ALL CROP CHECKPOINTS ====\n")
all_ckpt_files <- list.files(checkpoint_dir, pattern = "_distance_done\\.csv$", full.names = TRUE)
combined_list <- lapply(all_ckpt_files, read.csv)
final_df <- do.call(rbind, combined_list)

final_path <- file.path(output_dir, "step7_FULL_RQ5_distance_rmse.csv")
write.csv(final_df, final_path, row.names = FALSE)
cat("Total combined rows:", nrow(final_df), "\n")
cat("Saved to:", final_path, "\n")

total_elapsed_hours <- as.numeric(difftime(Sys.time(), overall_start, units = "hours"))
cat("\nTOTAL RUN TIME (this session):", round(total_elapsed_hours, 2), "hours\n")

# --- Overall correlation check ---
final_valid <- final_df[!is.na(final_df$distance) & !is.na(final_df$rmse) & is.finite(final_df$distance), ]
cat("\n==== OVERALL correlation (all crops, all models pooled) ====\n")
cor_result <- cor.test(final_valid$distance, final_valid$rmse, method = "spearman")
cat("Spearman rho:", round(cor_result$estimate, 3), " p =", format.pval(cor_result$p.value, digits=3), "\n")

# --- Per-crop correlation ---
cat("\n==== Per-crop correlation ====\n")
for (crop_name in all_crops) {
  sub <- final_valid[final_valid$crop == crop_name, ]
  if (nrow(sub) > 10) {
    ct <- cor.test(sub$distance, sub$rmse, method = "spearman")
    cat(crop_name, ": rho =", round(ct$estimate, 3), " p =", format.pval(ct$p.value, digits=3), "\n")
  }
}



















