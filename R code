# --- Function: standardize test set using TRAIN set's mean/sd (no leakage) ---
# This is standard practice: we learn the scaling from the source (train)
# countries only, then apply that same scaling to the target (test) country.
# The target's own mean/sd is never used - that would leak information.
standardize_with_train_stats <- function(train_df, test_df, cols) {
  train_means <- sapply(train_df[, cols], mean, na.rm = TRUE)
  train_sds   <- sapply(train_df[, cols], sd, na.rm = TRUE)
  
  for (col in cols) {
    train_df[[col]] <- (train_df[[col]] - train_means[col]) / train_sds[col]
    test_df[[col]]  <- (test_df[[col]]  - train_means[col]) / train_sds[col]
  }
  list(train = train_df, test = test_df)
}

# --- Function: fit LM (standardized) and predict ---
fit_and_predict_lm <- function(source_countries_str, target_country, data) {
  source_countries <- strsplit(source_countries_str, ";")[[1]]
  train_df <- data[data$Country_ISO %in% source_countries, ]
  test_df  <- data[data$Country_ISO == target_country, ]
  
  needed_cols <- c(predictor_cols, target_col)
  train_df <- train_df[complete.cases(train_df[, needed_cols]), ]
  test_df  <- test_df[complete.cases(test_df[, needed_cols]), ]
  
  if (nrow(train_df) < 10 || nrow(test_df) < 1) {
    return(data.frame(model = "LM", rmse = NA, mae = NA, n_train = nrow(train_df), n_test = nrow(test_df)))
  }
  
  scaled <- standardize_with_train_stats(train_df, test_df, predictor_cols)
  
  formula_str <- paste(target_col, "~", paste(predictor_cols, collapse = " + "))
  model <- lm(as.formula(formula_str), data = scaled$train)
  preds <- predict(model, newdata = scaled$test)
  actual <- scaled$test[[target_col]]
  
  data.frame(model = "LM",
             rmse = sqrt(mean((preds - actual)^2)),
             mae = mean(abs(preds - actual)),
             n_train = nrow(train_df), n_test = nrow(test_df))
}

# --- Function: fit LASSO (standardized - required, not optional) and predict ---
fit_and_predict_lasso <- function(source_countries_str, target_country, data) {
  source_countries <- strsplit(source_countries_str, ";")[[1]]
  train_df <- data[data$Country_ISO %in% source_countries, ]
  test_df  <- data[data$Country_ISO == target_country, ]
  
  needed_cols <- c(predictor_cols, target_col)
  train_df <- train_df[complete.cases(train_df[, needed_cols]), ]
  test_df  <- test_df[complete.cases(test_df[, needed_cols]), ]
  
  if (nrow(train_df) < 10 || nrow(test_df) < 1) {
    return(data.frame(model = "LASSO", rmse = NA, mae = NA, n_train = nrow(train_df), n_test = nrow(test_df)))
  }
  
  scaled <- standardize_with_train_stats(train_df, test_df, predictor_cols)
  
  x_train <- as.matrix(scaled$train[, predictor_cols])
  y_train <- scaled$train[[target_col]]
  x_test  <- as.matrix(scaled$test[, predictor_cols])
  y_test  <- scaled$test[[target_col]]
  
  # cv.glmnet picks the penalty strength (lambda) via internal cross-validation
  # on the training data only - target country is never touched here.
  cv_model <- cv.glmnet(x_train, y_train, alpha = 1)  # alpha=1 -> LASSO
  preds <- predict(cv_model, newx = x_test, s = "lambda.min")
  
  data.frame(model = "LASSO",
             rmse = sqrt(mean((preds - y_test)^2)),
             mae = mean(abs(preds - y_test)),
             n_train = nrow(train_df), n_test = nrow(test_df))
}

