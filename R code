write.csv(merged_valid, file.path(output_dir, "step7_RQ5_pilot_wheat_lm_distance_rmse.csv"), row.names = FALSE)
cat("\nSaved to: step7_RQ5_pilot_wheat_lm_distance_rmse.csv\n")

