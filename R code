  # Remove duplicate Country_ISO x Yil rows (keep row with most data)
  dup_check <- panelv7 %>%
    dplyr::group_by(Country_ISO, Yil) %>%
    dplyr::summarise(n = dplyr::n(), .groups = "drop") %>%
    dplyr::filter(n > 1)
  
  if (nrow(dup_check) > 0) {
    cat("  [", crop_name, "]", nrow(dup_check), "duplicate pairs -- removing\n")
    panelv7 <- panelv7 %>%
