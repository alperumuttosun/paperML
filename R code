    extra_raw2$Item %in% all_fao_items &
    extra_raw2$Element %in% c("Area harvested","Production","Yield") &
    extra_raw2$Year >= 1961 & extra_raw2$Year <= 2024, ]
fao_egy$Country_ISO <- "EGY"

fao_egy_wide <- fao_egy %>%
  dplyr::group_by(Country_ISO, Year, Item, Element) %>%
  dplyr::summarise(Value = mean(Value, na.rm = TRUE), .groups = "drop") %>%
  tidyr::pivot_wider(names_from = Element, values_from = Value) %>%
  as.data.frame()
names(fao_egy_wide)[names(fao_egy_wide) == "Area harvested"] <- "area_harvested_ha"
names(fao_egy_wide)[names(fao_egy_wide) == "Production"]     <- "production_tonnes"
names(fao_egy_wide)[names(fao_egy_wide) == "Yield"]          <- "yield_hg_per_ha"

for (crop_name in PATCH_CROPS) {
  cfg <- crop_config[[crop_name]]
  panelv3_path <- file.path(base_dir, paste0("panelv3_", crop_name, ".xlsx"))
  if (!file.exists(panelv3_path)) next
  panelv3 <- as.data.frame(readxl::read_excel(panelv3_path))
  if (sum(panelv3$Country_ISO == "EGY") > 0) {
    cat("  [SKIP]", crop_name, "EGY already in panelv3\n"); next
  }
  
  if (is.null(egy_climate_by_crop[[crop_name]])) next
  
  egy_monthly <- egy_climate_by_crop[[crop_name]]
  fao_sub     <- fao_egy_wide[fao_egy_wide$Item %in% cfg$fao, ]
  
  egy_annual <- egy_monthly %>%
    dplyr::arrange(Yil, Ay) %>%
    dplyr::group_by(Country_ISO, Yil) %>%
    dplyr::summarise(
      TMP_ann = mean(TMP, na.rm = TRUE), TMX_ann = mean(TMX, na.rm = TRUE),
      TMN_ann = mean(TMN, na.rm = TRUE), DTR_ann = mean(DTR, na.rm = TRUE),
      CLD_ann = mean(CLD, na.rm = TRUE), VAP_ann = mean(VAP, na.rm = TRUE),
      PRE_ann = sum(PRE,  na.rm = TRUE), PET_ann = sum(PET * days_in_month_of(Yil, Ay), na.rm = TRUE),
      WET_ann = sum(WET,  na.rm = TRUE), FRS_ann = sum(FRS, na.rm = TRUE),
      TempVariance = var(TMP, na.rm = TRUE),
      .groups = "drop") %>%
    dplyr::mutate(dplyr::across(dplyr::where(is.numeric),
                                ~ifelse(is.nan(.), NA_real_, .)))
  
  egy_annual <- egy_annual %>%
    dplyr::left_join(
      fao_sub[, c("Country_ISO","Year","area_harvested_ha",
                  "production_tonnes","yield_hg_per_ha")],
      by = c("Country_ISO","Yil" = "Year")) %>%
    dplyr::left_join(co2_df, by = "Yil") %>%
    dplyr::left_join(gdp_fallback, by = c("Country_ISO","Yil"))
  
  egy_annual <- egy_annual[!is.na(egy_annual$production_tonnes), ]
  egy_annual <- egy_annual[!is.na(egy_annual$yield_hg_per_ha) &
                             egy_annual$yield_hg_per_ha >= YIELD_THRESHOLD, ]
  
  for (k in setdiff(names(panelv3),  names(egy_annual))) egy_annual[[k]] <- NA
  for (k in setdiff(names(egy_annual), names(panelv3)))  panelv3[[k]]    <- NA
  common_cols <- union(names(panelv3), names(egy_annual))
  panelv3_new <- rbind(panelv3[, common_cols], egy_annual[, common_cols])
  panelv3_new <- panelv3_new[order(panelv3_new$Country_ISO, panelv3_new$Yil), ]
  rownames(panelv3_new) <- NULL
  
  writexl::write_xlsx(panelv3_new, panelv3_path)
  cat("  [SAVED]", crop_name, "EGY added ->", nrow(panelv3_new), "rows\n")
  rm(panelv3, egy_annual, panelv3_new); gc()
}


