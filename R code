# Within-country linear interpolation to fill remaining gaps
# Within-country linear interpolation: fills GAPS between two real WDI
# observations. rule = 1 (NOT 2) deliberately leaves years OUTSIDE a
# country's genuinely observed WDI range as NA, rather than extrapolating
# the nearest real value forward/backward indefinitely. rule = 2 was found
# to silently hold GDP_per_Capita constant for a decade or more in
# countries with real WDI coverage gaps (e.g. Eritrea 2011-2024, Yemen
# 2018-2024 -- both conflict/data-collection-crisis periods), which is a
# pipeline-introduced artifact, not real WDI data. With rule = 1, GDP
# interpolation is confined to each country's genuinely observed WDI
# coverage window; no extrapolation beyond the last/first real observation.
full_grid <- expand.grid(
  Country_ISO = unique(gdp_clean$Country_ISO),
  Yil         = 1961:2024,
  stringsAsFactors = FALSE)

gdp_full <- full_grid %>%
  dplyr::left_join(gdp_clean, by = c("Country_ISO","Yil")) %>%
  dplyr::group_by(Country_ISO) %>%
  dplyr::mutate(
    n_observed = sum(!is.na(GDP_per_Capita)),
    GDP_per_Capita = ifelse(
      n_observed >= 2,
      approx(x    = Yil[!is.na(GDP_per_Capita)],
             y    = GDP_per_Capita[!is.na(GDP_per_Capita)],
             xout = Yil,
             rule = 1)$y,   # rule=1: NA outside observed range (no extrapolation)
      GDP_per_Capita)) %>%
  dplyr::ungroup() %>%
  dplyr::select(-n_observed) %>%
  dplyr::filter(!is.na(GDP_per_Capita))

cat("[OK] GDP full grid:", nrow(gdp_full), "rows |",
    length(unique(gdp_full$Country_ISO)), "countries\n")

# Function: remove backfilled GDP values (constant run at start of series)
remove_gdp_backfill <- function(df) {
  df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::arrange(Yil, .by_group = TRUE) %>%
    dplyr::mutate(
      GDP_per_Capita = (function(x) {
        result   <- x
        non_na   <- which(!is.na(x))
        if (length(non_na) < 2) return(result)
        first_change <- NA_integer_
        for (k in 2:length(non_na)) {
          if (x[non_na[k]] != x[non_na[k - 1]]) {
            first_change <- non_na[k - 1]; break
          }
        }
        if (is.na(first_change)) { result[] <- NA; return(result) }
        if (first_change > 1) result[1:(first_change - 1)] <- NA
        result
      })(GDP_per_Capita)) %>%
    dplyr::ungroup()
}

