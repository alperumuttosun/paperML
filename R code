          if (!all(is.na(preds))) {
            m <- compute_metrics(preds, scaled$test[[target_col]])
            crop_results[[row_i]] <- data.frame(
              crop = crop_name, target_country = target, N = N, replicate_id = r,
              model = model_name, rmse = m$rmse, mae = m$mae,
              n_train = nrow(prep$train), n_test = nrow(prep$test)
            )
          } else {
            crop_results[[row_i]] <- data.frame(
              crop = crop_name, target_country = target, N = N, replicate_id = r,
              model = model_name, rmse = NA, mae = NA,
              n_train = nrow(prep$train), n_test = nrow(prep$test)
