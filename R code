# --- Function: for one crop, build the sampling plan ---
build_sampling_plan <- function(crop_name, countries, source_sizes, n_replicates) {
  
  n_total <- length(countries)
  plan_rows <- list()
  row_counter <- 1
  
  # Pick a modest number of target countries to keep computation manageable.
  # For now: use ALL countries as potential targets (we can subsample later
  # if this turns out to be too heavy - see Stage 6 pilot timing test).
  target_candidates <- countries
  
  for (target in target_candidates) {
    
    remaining <- setdiff(countries, target)  # target must never appear in source set
    n_remaining <- length(remaining)
    
    for (N in source_sizes) {
      
      # Skip this (target, N) combination if there aren't enough remaining
      # countries to draw N source countries from.
      if (N > n_remaining) {
        next
      }
      
      for (r in 1:n_replicates) {
        source_set <- sample(remaining, size = N, replace = FALSE)
        
        plan_rows[[row_counter]] <- data.frame(
          crop = crop_name,
          target_country = target,
          N = N,
          replicate_id = r,
          source_countries = paste(source_set, collapse = ";")
        )
        row_counter <- row_counter + 1
      }
    }
  }
  
  do.call(rbind, plan_rows)
}

