    for (N in source_sizes) {
      rmse_vals <- c()

      for (target in all_countries) {
        remaining <- setdiff(all_countries, target)
        if (N > length(remaining)) next
        target_idx <- which(all_countries == target)

        for (r in 1:n_replicates) {
          # SAME seed formula as the main design, so source-country draws
          # are identical to those already used in step4_FULL_climate_gdp.R
          set.seed(10000 * target_idx + 100 * N + r)
          source_set <- sample(remaining, size = N, replace = FALSE)

          rmse_val <- fit_lm_rmse(source_set, target, crop_data, y_col)
          if (!is.na(rmse_val)) rmse_vals <- c(rmse_vals, rmse_val)
        }
      }

      all_pilot_results[[paste(crop_name, y_col, N, sep = "_")]] <- data.frame(
        crop = crop_name, target_variable = y_col, N = N,
        median_rmse = median(rmse_vals, na.rm = TRUE),
        q25_rmse = quantile(rmse_vals, 0.25, na.rm = TRUE),
        q75_rmse = quantile(rmse_vals, 0.75, na.rm = TRUE),
        n_obs = length(rmse_vals)
      )

      cat("  N =", N, ": median RMSE =", round(median(rmse_vals, na.rm = TRUE), 1),
          " (n =", length(rmse_vals), ")\n")
    }

    y_elapsed <- as.numeric(difftime(Sys.time(), y_start, units = "mins"))
    cat("  [", round(y_elapsed, 1), "min for this target variable]\n")
  }
}

